# Kopiere diese Datei zu `.env.local` und trage deine realen Werte ein.
# Prisma-Skripte lesen `.env.local` automatisch via dotenv-cli.

# PocketBase Public Endpoint (Client)
PUBLIC_POCKETBASE_URL="http://localhost:8090"

# PocketBase Admin Credentials (Server)
POCKETBASE_ADMIN_EMAIL="admin@inventauri.local"
POCKETBASE_ADMIN_PASSWORD="replace-me-with-a-strong-secret"
POCKETBASE_SERVICE_ROLE_TOKEN="pocketbase-service-token"

# Postgres Verbindung (Lokal/Docker)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/inventauri"

# Seed Defaults (optional)
SEED_CENTRAL_NAME="Hauptlager HQ"
SEED_CENTRAL_SLUG="central-hq"

# Feature Flags / Migration Settings
FEATURE_POCKETBASE_ENABLED="true"
POCKETBASE_MIGRATION_LOG="tmp/pb-migration-report.json"
