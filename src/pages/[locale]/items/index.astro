---
import AppLayout from "../../../layouts/AppLayout.astro";
import { Button } from "../../../components/ui/button";
import { ItemList } from "../../../components/items/ItemList";
import { getInventorySnapshot } from "../../../lib/data/inventory";
import { requireUser } from "../../../lib/auth/server";
import {
  getTranslationFunction,
  getLocaleAttributes,
} from "../../../i18n/astro";
import type { Locale } from "../../../i18n/constants";

const locale = (Astro.params.locale as Locale) || "en";
const t = getTranslationFunction(Astro);
const localeAttrs = getLocaleAttributes(locale);
const pageTitle = t("navigation.itemManagement");
const pageDescription = t("navigation.itemManagement");

const auth = await requireUser(Astro.request);
const snapshot = await getInventorySnapshot();
---

<html {...localeAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} • Inventauri</title>
    <meta name="description" content={pageDescription} />
  </head>
  <body class="bg-background text-foreground">
    <AppLayout title={pageTitle} description={pageDescription}>
      <section
        class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
      >
        <div>
          <h2 class="text-lg font-semibold">{t("items.title")}</h2>
          <p class="text-sm text-muted-foreground">{t("items.description")}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <Button client:load asChild>
            <a href="/{locale}/items/new">{t("items.createNew")}</a>
          </Button>
        </div>
      </section>

      <ItemList
        client:load
        items={snapshot.items}
        warehouseTotals={snapshot.warehouseTotals.map((warehouse) => ({
          warehouseId: warehouse.warehouseId,
          warehouseName: warehouse.warehouseName,
        }))}
        locale={locale}
      />
    </AppLayout>
  </body>
</html>
