---
import '../../styles/global.css';
import { LoginForm } from '../../components/auth/LoginForm';
import { ThemeToggle } from '../../components/ui/theme-toggle';
import { getTranslationFunction, getLocaleAttributes } from '../../i18n/astro';
import type { Locale } from '../../i18n/constants';

const redirectTo = Astro.url.searchParams.get('redirectTo') ?? `/${Astro.params.locale}/dashboard`;
const locale = Astro.params.locale as Locale || 'en';
const t = getTranslationFunction(Astro);
const localeAttrs = getLocaleAttributes(locale);
---

<html {...localeAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('auth.login')} • Inventauri</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-background text-foreground">
    <div class="w-full max-w-md space-y-8 rounded-2xl border border-border bg-card/80 p-8 shadow-lg">
      <div class="space-y-2 text-center">
        <h1 class="text-2xl font-bold">{t('auth.welcomeBack')}</h1>
        <p class="text-sm text-muted-foreground">
          {t('auth.loginToInventauri')}
        </p>
      </div>
      <LoginForm client:load redirectTo={redirectTo} />

      {/* Theme toggle positioned at bottom of login card on mobile, top-right on desktop */}
      <div class="flex justify-end sm:justify-center">
        <ThemeToggle
          client:load
          className="sm:absolute sm:top-4 sm:right-4"
          disabled={false}
        />
      </div>

      <div class="space-y-3 text-xs text-muted-foreground">
        <p>
          Tip: Add Magic Links or OAuth providers by extending the logic in
          <code>src/components/auth/LoginForm.tsx</code>.
        </p>
      </div>
    </div>
  </body>
</html>