---
import AppLayout from "../../../layouts/AppLayout.astro";
import { DashboardOverview } from "../../../components/dashboard/DashboardOverview";
import { getBusinessProfileViewModel } from "../../../lib/settings/view-model";
import {
  getTranslationFunction,
  getLocaleAttributes,
} from "../../../i18n/astro";
import type { Locale } from "../../../i18n/constants";

const locale = (Astro.params.locale as Locale) || "en";
const t = getTranslationFunction(Astro);
const businessProfile = await getBusinessProfileViewModel();

const pageTitle =
  locale === "de"
    ? `${businessProfile.displayName} · Dashboard`
    : `${businessProfile.displayName} · Dashboard`;

const pageDescription = businessProfile.location
  ? locale === "de"
    ? `Kennzahlen & Aufgaben für ${businessProfile.location}`
    : `Metrics & tasks for ${businessProfile.location}`
  : locale === "de"
    ? "Kennzahlen, offene Aufgaben & Schnellzugriffe"
    : "Metrics, open tasks & quick access";

const localeAttrs = getLocaleAttributes(locale);
---

<html {...localeAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
  </head>
  <body class="bg-background text-foreground">
    <AppLayout title={pageTitle} description={pageDescription}>
      <DashboardOverview locale={locale} client:load />
    </AppLayout>
  </body>
</html>
