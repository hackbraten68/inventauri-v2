---
import AppLayout from "../../../layouts/AppLayout.astro";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "../../../components/ui/card";
import { PosTerminal } from "../../../components/pos/PosTerminal";
import { getPosInventory, listPosWarehouses } from "../../../lib/data/pos";
import { requireUser } from "../../../lib/auth/server";
import {
  getTranslationFunction,
  getLocaleAttributes,
} from "../../../i18n/astro";
import type { Locale } from "../../../i18n/constants";

const locale = (Astro.params.locale as Locale) || "en";
const t = getTranslationFunction(Astro);
const localeAttrs = getLocaleAttributes(locale);
const pageTitle = t("navigation.posWarehouse");
const pageDescription = t("navigation.posWarehouse");

const warehouseSlug = Astro.url.searchParams.get("warehouse");
const auth = await requireUser(Astro.request);
const [inventory, warehouses] = await Promise.all([
  getPosInventory(warehouseSlug ?? undefined),
  listPosWarehouses(),
]);
---

<html {...localeAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} • Inventauri</title>
    <meta name="description" content={pageDescription} />
  </head>
  <body class="bg-background text-foreground">
    <AppLayout title={pageTitle} description={pageDescription}>
      <section class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold">
              {t("navigation.posWarehouse")}
            </h2>
            <p class="text-sm text-muted-foreground">
              {t("pos.description")}
            </p>
          </div>
          <div class="flex items-center gap-3">
            {
              warehouses.length === 0 && (
                <a
                  href={`/${locale}/settings?tab=locations`}
                  class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mr-2"
                  >
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                  </svg>
                  {t("pos.addLocation")}
                </a>
              )
            }
            {
              warehouses.length > 0 ? (
                <form method="get" class="flex items-center gap-2 text-sm">
                  <label for="warehouse" class="text-muted-foreground">
                    {t("pos.selectWarehouse")}
                  </label>
                  <select
                    id="warehouse"
                    name="warehouse"
                    class="rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm"
                    onchange="this.form.requestSubmit()"
                  >
                    {warehouses.map((warehouse) => (
                      <option
                        value={warehouse.slug}
                        selected={inventory.warehouse?.slug === warehouse.slug}
                      >
                        {warehouse.name}
                      </option>
                    ))}
                  </select>
                </form>
              ) : null
            }
          </div>

          {
            inventory.warehouse ? (
              <Card className="border-border">
                <CardHeader>
                  <CardTitle>{t("pos.title")}</CardTitle>
                </CardHeader>
                <CardContent>
                  <PosTerminal
                    client:load
                    warehouseId={inventory.warehouse.id}
                    warehouseSlug={inventory.warehouse.slug}
                    warehouseName={inventory.warehouse.name}
                    items={inventory.items}
                    locale={locale}
                  />
                </CardContent>
              </Card>
            ) : (
              <Card className="border-border">
                <CardContent className="py-10 text-center text-sm text-muted-foreground">
                  {t("pos.noWarehouse")}
                </CardContent>
              </Card>
            )
          }
        </div>
      </section>
    </AppLayout>
  </body>
</html>
