---
import AppLayout from "../../../layouts/AppLayout.astro";
import { InventoryManager } from "../../../components/inventory/InventoryManager";
import { getInventorySnapshot } from "../../../lib/data/inventory";
import { requireUser } from "../../../lib/auth/server";
import {
  getTranslationFunction,
  getLocaleAttributes,
} from "../../../i18n/astro";
import type { Locale } from "../../../i18n/constants";

const locale = (Astro.params.locale as Locale) || "en";
const t = getTranslationFunction(Astro);
const localeAttrs = getLocaleAttributes(locale);
const pageTitle = t("navigation.totalInventory");
const pageDescription = t("navigation.totalInventory");

const auth = await requireUser(Astro.request);
const snapshot = await getInventorySnapshot();
---

<html {...localeAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} • Inventauri</title>
    <meta name="description" content={pageDescription} />
  </head>
  <body class="bg-background text-foreground">
    <AppLayout title={pageTitle} description={pageDescription}>
      <InventoryManager
        client:load
        initialSnapshot={snapshot}
        locale={locale}
      />
    </AppLayout>
  </body>
</html>
