---
import "../styles/global.css";
import { OnboardingWorkflow } from "../components/setup/OnboardingWorkflow";
import { ThemeToggle } from "../components/ui/theme-toggle";
import { LayoutDashboard } from "lucide-react";
---

<html lang="de">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Setup • Inventauri</title>
    </head>
    <body
        class="min-h-screen bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-slate-50 via-white to-slate-100 dark:from-slate-950 dark:via-slate-900 dark:to-black text-foreground"
    >
        <div
            class="relative flex flex-col items-center justify-center p-6 md:p-12 min-h-screen"
        >
            <!-- Decorative background elements -->
            <div
                class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-20 dark:opacity-40"
            >
                <div
                    class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary/20 blur-[120px]"
                >
                </div>
                <div
                    class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-blue-500/20 blur-[120px]"
                >
                </div>
            </div>

            <div class="z-10 w-full max-w-4xl space-y-12">
                <header class="text-center space-y-4">
                    <div
                        class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary shadow-xl shadow-primary/20 animate-in zoom-in duration-500"
                    >
                        <LayoutDashboard className="h-8 w-8 text-white" />
                    </div>
                    <div class="space-y-2">
                        <h1
                            class="text-4xl font-black tracking-tight sm:text-5xl bg-clip-text text-transparent bg-gradient-to-br from-foreground to-foreground/70"
                        >
                            Willkommen bei Inventauri
                        </h1>
                        <p
                            class="text-lg text-muted-foreground font-medium max-w-xl mx-auto"
                        >
                            In wenigen Schritten machen wir Ihre Instanz
                            startklar für das professionelle Bestandsmanagement.
                        </p>
                    </div>
                </header>

                <OnboardingWorkflow client:load />

                <footer class="flex items-center justify-center gap-6 pt-12">
                    <ThemeToggle client:load />
                    <span class="h-4 w-[1px] bg-border"></span>
                    <p class="text-xs text-muted-foreground">
                        © 2026 DeepMind Inventauri Team
                    </p>
                </footer>
            </div>
        </div>
    </body>
</html>
