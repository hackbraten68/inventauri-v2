---
// Detect browser language or default to English
const browserLang = Astro.request.headers.get('accept-language')?.split(',')[0]?.slice(0, 2) || 'en';
const supportedLocales = ['en', 'de'];
const locale = supportedLocales.includes(browserLang) ? browserLang : 'en';

// Redirect to localized version - assuming setup is under en/
return Astro.redirect(`/${locale}/setup/`);
